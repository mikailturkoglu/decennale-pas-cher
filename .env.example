# ---------------------------------------------------------------------------
# DécennaleBTP.fr — variables d'environnement
# Copier ce fichier en .env.local puis renseigner les valeurs.
# Aucune de ces valeurs ne doit être commitée dans Git.
# ---------------------------------------------------------------------------

# URL publique canonique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://decennalebtp.fr

# Base de données PostgreSQL (optionnelle : sans elle, les leads ne sont pas persistés)
DATABASE_URL=

# Emails transactionnels (notifications internes de leads)
# EMAIL_PROVIDER : console | brevo-smtp | smtp
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_FROM=
LEAD_NOTIFICATION_EMAIL=

# CRM / courtier partenaire
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Stockage objet des pièces jointes
UPLOAD_BUCKET=
UPLOAD_REGION=
UPLOAD_ACCESS_KEY=
UPLOAD_SECRET_KEY=

# Anti-spam (Cloudflare Turnstile). Laisser vide désactive la vérification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supervision et mesure d'audience
SENTRY_DSN=
# Google Analytics 4 — chargé dès le chargement de la page
NEXT_PUBLIC_ANALYTICS_ID=G-EP0QXYZW8G

# Autorise les placeholders bloquants ([À RENSEIGNER], ...) au build.
# Doit rester "false" pour un build de production.
ALLOW_BLOCKING_PLACEHOLDERS=true
